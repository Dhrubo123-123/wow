# ASCEND environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local.

# --- Supabase (client + server) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the client, never prefix with NEXT_PUBLIC_.
# Required starting Phase 2 for privileged server-side operations (migrations, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (server-only, Phase 6) ---
# NEVER expose these in client components, browser network payloads, public
# env vars, git, README, or any source file. Server-side API routes only.
# See lib/ai/index.ts for the selection logic and ARCHITECTURE.md §10 for
# why a fallback provider exists.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Optional fallback provider (same request/response shape as Cerebras;
# also hosts gpt-oss-120b, so no quality tradeoff from switching).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: force a specific provider — "cerebras" | "groq" | "mock".
# Without this, the factory prefers Cerebras, then Groq, then the mock.
AI_PROVIDER=
